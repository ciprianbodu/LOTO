#!/bin/sh
# Auto-push origin/main after a commit on main.
# Installed by START_8000.bat / ACTUALIZARI.bat: git config core.hooksPath scripts/git-hooks
# Disable one commit: LOTO_SKIP_AUTO_PUSH=1
# Never force-push. Closed stdin + GIT_TERMINAL_PROMPT=0 so a credential
# prompt cannot hang START_8000 / ACTUALIZARI.

if [ -n "${LOTO_SKIP_AUTO_PUSH:-}" ]; then
    exit 0
fi

git_dir=$(git rev-parse --git-dir 2>/dev/null) || exit 0
for p in rebase-merge rebase-apply MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD; do
    if [ -e "$git_dir/$p" ]; then
        exit 0
    fi
done

branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null) || exit 0
if [ "$branch" != "main" ]; then
    exit 0
fi

# Amend of an already-pushed commit cannot fast-forward; leave it local.
case "$(git log -g -1 --format=%gs 2>/dev/null)" in
    *commit\ \(amend\)*) exit 0 ;;
esac

if git rev-parse --verify -q origin/main >/dev/null 2>&1; then
    ahead=$(git rev-list --count origin/main..HEAD 2>/dev/null || echo 0)
    if [ "$ahead" = "0" ]; then
        exit 0
    fi
fi

# Commits withdrawn from origin/main by a force-push are not pushed back: the
# same rule as Get-WithdrawnCommits in scripts/launcher_git.ps1.
former=$( { git reflog show --format=%H -n 200 refs/remotes/origin/main
            git for-each-ref --format='%(objectname)' refs/loto/withdrawn; } 2>/dev/null | sort -u)
if [ -n "$former" ] && git rev-parse --verify -q origin/main >/dev/null 2>&1; then
    total=$(git rev-list --count HEAD --not origin/main 2>/dev/null || echo 0)
    fresh=$(git rev-list --count HEAD --not origin/main $former 2>/dev/null || echo 0)
    if [ "$fresh" != "$total" ]; then
        echo "[git] auto-push skipped: main contains commits withdrawn from origin/main" >&2
        exit 0
    fi
fi

GIT_TERMINAL_PROMPT=0
export GIT_TERMINAL_PROMPT
# Output captured only to tell a rejection apart; printed unchanged.
if out=$(git push --quiet origin main </dev/null 2>&1); then
    [ -z "$out" ] || printf '%s\n' "$out" >&2
    echo "[git] auto-push origin/main ok" >&2
else
    [ -z "$out" ] || printf '%s\n' "$out" >&2
    # Rejected: origin/main has commits HEAD lacks, a bare retry fails again.
    case "$out" in
        *'[rejected]'*)
            # Same tests as Sync (scripts/launcher_git.ps1), in its order: an
            # unpushed merge commit, or a former main tip in HEAD..origin/main
            # (a pushed commit rewritten by amend/reset), stays manual there.
            why=
            merges=$(git rev-list --merges --count origin/main..HEAD 2>/dev/null || echo 0)
            if [ "$merges" != "0" ]; then
                why="are un commit de merge netrimis"
            else
                up=$(git rev-list HEAD..origin/main 2>/dev/null)
                if [ -n "$up" ] && git reflog show --format=%H -n 200 refs/heads/main 2>/dev/null | grep -qxF "$up"; then
                    why="rescrie un commit deja trimis (amend sau reset)"
                fi
            fi
            if [ -n "$why" ]; then
                echo "[git] auto-push respins: main local $why; commit-ul ramane local, iar integrarea cu origin/main ramane manuala." >&2
            else
                echo "[git] auto-push respins: origin/main are commit-uri noi; commit-ul ramane local. Integrati intai: porniti START_8000.bat sau ACTUALIZARI.bat (Sync integreaza si trimite) sau rulati git pull --rebase origin main, apoi git push origin main" >&2
            fi ;;
        *)
            echo "[git] auto-push failed; commit is local. Retry: git push origin main" >&2 ;;
    esac
fi
exit 0
