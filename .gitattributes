# CMD.EXE cere CRLF in .bat/.cmd. Cu LF:
#   `for /f`  -> "'f' is not recognized as an internal or external command"
#   `echo.`   -> "'ho.' is not recognized as an internal or external command"
*.bat text eol=crlf
*.cmd text eol=crlf
scripts/git-hooks/* text eol=lf
# Amprenta copiei inghetate din testul preinregistrat se calculeaza pe LF.
scripts/analysis/forward_test/* text eol=lf
# Istoricele externe: testul si amprentele din external_replication.md cer LF.
_ISTORIC/externe/*.csv text eol=lf
# Istoricele romanesti: update_csv.py scrie LF.
_ISTORIC/*.csv text eol=lf
# Studiul semneaza manifestul pe octeti; pastreaza CRLF/LF exact ca la rulare.
scripts/analysis/pool_selection_649_2026-10-19*.json -text diff whitespace=cr-at-eol
scripts/analysis/pool_selection_649_2026-10-19*.csv -text diff whitespace=cr-at-eol
scripts/analysis/pool_selection_649_2026-10-19*.md -text diff whitespace=cr-at-eol
# Noua runda scrie explicit LF, inclusiv manifestul semnat.
scripts/analysis/pool_combinations_649_2026-10-19*.json text eol=lf
scripts/analysis/pool_combinations_649_2026-10-19*.csv text eol=lf
scripts/analysis/pool_combinations_649_2026-10-19*.md text eol=lf
