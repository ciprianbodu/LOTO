# Runtime artefacts (heavy, regenerated on demand)
lightning_logs/
# NOTĂ: _ISTORIC/ NU mai e ignorat — CSV-urile cu extragerile sunt versionate
# (sursa de adevăr pentru bench/analiză). Le comiți din local cu:
#   git add _ISTORIC && git commit -m "update istoric" && git push
# bench_results: ignorăm tot FOLDER-ul, dar permitem folds.csv + report.json
# (le comiți manual ca să le pot analiza). .pkl-urile grele rămân ignorate.
bench_results/*
!bench_results/folds.csv
!bench_results/report.json
*.pre_autopilot

# Per-machine runtime state (regenerated each pipeline run)
pool_history.json

# Auto-Pilot runtime flags
.bench_pid
.regenerate_after_bench
.shutdown_pending.flag
.ui_state.json
bench_full.log

# Runtime / machine-specific (nu se versioneaza)
.button_press_ts
.machine_profile
